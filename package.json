{
  "name": "online-auction-monorepo",
  "private": true,
  "version": "1.0.3",
  "scripts": {
    "start": "concurrently \"npm:server\" \"npm:client\"",
    "server": "npm --prefix backend start",
    "client": "npm --prefix frontend start",
    "install-all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "all": "^0.0.0"
  }
}
